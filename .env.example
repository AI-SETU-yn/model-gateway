MODEL_GATEWAY_APP_NAME=yn-ai-setu-model-gateway
MODEL_GATEWAY_ENVIRONMENT=local
MODEL_GATEWAY_HOST=0.0.0.0
MODEL_GATEWAY_PORT=9000
MODEL_GATEWAY_LOG_LEVEL=INFO
MODEL_GATEWAY_READY_ON_STARTUP=true
MODEL_GATEWAY_CONFIG_PATH=configs/model.yaml
MODEL_GATEWAY_MAX_CONCURRENT_REQUESTS=4
MODEL_GATEWAY_METRICS_ENABLED=true
MODEL_GATEWAY_LITELLM_TIMEOUT_SECONDS=90
MODEL_GATEWAY_LITELLM_MAX_RETRIES=2
MODEL_GATEWAY_LITELLM_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_GATEWAY_LITELLM_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30
